# Template for .env — commit this file, never commit .env itself.
# Copy to .env and fill in real values:  cp .env.example .env

# --- Supabase ---------------------------------------------------------------
# From the Supabase dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WARNING: the service role key BYPASSES row-level security entirely.
# Row-level security is this project's authorization guarantee, so this key
# must never be imported into client-side code or exposed to the browser.
# Server-side use only (migrations, bulk ingestion, scheduled jobs).
SUPABASE_SERVICE_ROLE_KEY=

# --- Language model ---------------------------------------------------------
# Used for two things only: business classification and explanatory text.
# Never for arithmetic.
ANTHROPIC_API_KEY=

# --- Public registers -------------------------------------------------------
# Brønnøysundregistrene requires no authentication. Kept configurable so
# tests can point at a local fixture server instead of the live API.
BRREG_API_BASE_URL=https://data.brreg.no
