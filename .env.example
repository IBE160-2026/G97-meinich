# Template for .env — commit this file, never commit .env itself.
# Copy to .env:  cp .env.example .env
#
# v1 needs no secret to run. Every value below is either a local default
# printed by `supabase status` or optional. Nothing here may reach the
# browser: in v1 no NEXT_PUBLIC_ variable exists, and CI fails on one
# (technical note, AD-19).

# --- Database roles (technical note, AD-3) -----------------------------------
# One role per writer, plus the request path's SELECT-only reader.
# Role passwords are set locally and never committed.

# Next.js server only — read in src/server/db.ts, never in client code.
READER_DATABASE_URL=

# Batch step 1 (Python): register data, OCR, reconciled raw figures.
INGEST_DATABASE_URL=

# Batch step 2 (Node): fingerprints, classifications, stored explanations.
DERIVE_DATABASE_URL=

# Seed loader (`pnpm seed`, `pnpm seed:full`).
LOADER_DATABASE_URL=

# --- Language model -----------------------------------------------------------
# Batch step 2 only. Optional: without it the app runs on the stored
# explanations and classifications in the seed (AD-7). Used for two things
# only — business classification and explanatory text — never arithmetic.
ANTHROPIC_API_KEY=

# --- Public registers ---------------------------------------------------------
# Batch step 1 only; the app never calls the register. Brønnøysundregistrene
# requires no authentication. Configurable so tests can point at a local
# fixture server.
BRREG_API_BASE_URL=https://data.brreg.no

# --- Stage 2 only — leave commented out in v1 --------------------------------
# Browser sign-in by magic link. These are the only NEXT_PUBLIC_ variables
# the CI check will allow, from stage 2, and nothing else.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# WARNING: the service role key BYPASSES row-level security entirely. Never
# in client code and never in a user request (AD-4). Not used in v1.
# SUPABASE_SERVICE_ROLE_KEY=
