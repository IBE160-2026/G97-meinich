{
  "name": "peerless",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:pins": "node scripts/check-pinned-deps.ts",
    "check:env": "node scripts/check-no-public-env.ts",
    "check:routes": "node scripts/check-routes.ts",
    "db:start": "supabase db start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:roles": "node scripts/set-role-passwords.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "ingest": "node scripts/run-ingest.ts",
    "test:ingest": "uv --directory ingest run --frozen pytest",
    "seed:export": "node scripts/seed-export.ts",
    "seed": "node scripts/seed-load.ts",
    "ingest:document-set": "node scripts/document-set.ts",
    "analysis:sm2": "node scripts/ocr-sm2.ts",
    "analysis:document-run": "node scripts/document-run-counts.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "decimal.js": "10.6.0",
    "next": "16.4.2",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
